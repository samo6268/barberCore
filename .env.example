# Database
POSTGRES_USER=barbercore
POSTGRES_PASSWORD=barbercore_secret
POSTGRES_DB=barbercore_db
DATABASE_URL=postgresql://barbercore:barbercore_secret@localhost:5432/barbercore_db?schema=public

# Redis
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_access
JWT_REFRESH_SECRET=change_me_to_a_long_random_string_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMS - Kavenegar
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=parnegarinlogin

# Payment - ZarinPal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Storage - Arvan Cloud (S3-compatible)
ARVAN_ACCESS_KEY=
ARVAN_SECRET_KEY=
ARVAN_BUCKET_NAME=barbercore
ARVAN_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir

# App
NODE_ENV=development
API_PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mimo - internal knowledge assistant; no external model or API key required.
ASSISTANT_DAILY_TURN_LIMIT=60
# Existing API monetary values are IRR. Use IRT only if your database stores Toman.
ASSISTANT_PRICE_UNIT=IRR
# Optional JSON array of additional businesses; see docs/assistant/INTERNAL_KNOWLEDGE_SETUP.md.
ASSISTANT_BUSINESSES_JSON=
# Grounded workflow guidance works in rules mode without any model.
ASSISTANT_REASONING_MODE=rules
# Optional self-hosted Ollama; native API, private hosts and local model tags only.
ASSISTANT_OLLAMA_URL=http://ollama:11434
ASSISTANT_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
ASSISTANT_OLLAMA_TIMEOUT_MS=15000
